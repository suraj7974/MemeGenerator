{
  "version": 2,
  "builds": [
    {
      "src": "dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "meme-bot-backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "meme-bot-backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "dist/$1"
    }
  ]
}